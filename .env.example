# ======================================================
#  QMS TESTNET BOT - WALLET CONFIGURATION
# ======================================================
# Copy this file to .env and fill in your wallet private keys
# Format: PRIVATE_KEY_1, PRIVATE_KEY_2, etc.
# Separate multiple wallets with a comma (,)

PRIVATE_KEYS=0xYOUR_PRIVATE_KEY_1,0xYOUR_PRIVATE_KEY_2,0xYOUR_PRIVATE_KEY_3

# ======================================================
#  BOT CONFIGURATION
# ======================================================

# Delay between each action in milliseconds (default: 10-30s random)
DELAY_MIN_MS=10000
DELAY_MAX_MS=30000

# Delay between cycles in milliseconds (default: 60-120s random)
CYCLE_DELAY_MIN_MS=60000
CYCLE_DELAY_MAX_MS=120000

# Number of cycles (0 = unlimited)
MAX_CYCLES=0

# Percentage of native QMS balance used per swap (0.05 = 5%)
SWAP_AMOUNT_PERCENT=0.05

# Enable / disable specific features (true/false)
ENABLE_SWAP=true
ENABLE_ADD_LIQUIDITY=true
ENABLE_REMOVE_LIQUIDITY=true
ENABLE_WRAP_UNWRAP=true
ENABLE_TRANSFER=true

# Amount per transfer between owned wallets (in native QMS)
TRANSFER_AMOUNT=0.001

# ======================================================
#  QUANTA BOT SETTINGS (quanta-bot.js)
# ======================================================

# Number of sets per wallet (max 10 per Discord rules)
MAX_SETS=10

# Delay between sets in ms (900000 = 15 minutes - per Discord tracking)
SET_DELAY_MS=900000
